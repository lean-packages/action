{
  "name": "lean-packages-action",
  "version": "1.0.0",
  "private": true,
  "description": "Unified GitHub Action for linting package distribution contents across PHP, Ruby, Rust, Python, JavaScript, and Zig.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "github-actions",
    "lean-packages",
    "lint",
    "packaging"
  ],
  "author": "lean-packages",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/http-client": "^2.2.3",
    "@actions/io": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
